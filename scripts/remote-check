#!/usr/bin/env bash
# Snapshot the working tree (including uncommitted changes) with Errand, then
# run Nix commands on a Linux host with /dev/kvm. KVM-accelerated VM tests run
# several times faster than the software-emulated QEMU path available inside
# Docker on Apple Silicon.
#
# Usage:
#   scripts/remote-check                    # nix flake check on the remote host
#   scripts/remote-check build .#checks.x86_64-linux.host-contract
#   scripts/remote-check build .#checks.x86_64-linux.installed-host --no-link
#
# Configuration:
#   ATLAS_ERRAND_HOST  Errand destination (default: cabal)
set -euo pipefail

host="${ATLAS_ERRAND_HOST:-cabal}"
workspace_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [[ ! "$host" =~ ^[A-Za-z0-9][A-Za-z0-9._:-]*$ ]]; then
  echo "ATLAS_ERRAND_HOST must be a simple Errand destination" >&2
  exit 2
fi

if ! command -v errand >/dev/null 2>&1; then
  echo "errand is required; install it before running remote checks" >&2
  exit 127
fi

if [ "$#" -eq 0 ]; then
  set -- flake check path:.
else
  remote_arguments=()
  for argument in "$@"; do
    case "$argument" in
      .)
        remote_arguments+=("path:.")
        ;;
      .\#*)
        remote_arguments+=("path:$argument")
        ;;
      *)
        remote_arguments+=("$argument")
        ;;
    esac
  done
  set -- "${remote_arguments[@]}"
fi

cd "$workspace_root"
exec errand --on "$host" -- \
  /usr/bin/nix --extra-experimental-features 'nix-command flakes' "$@"
